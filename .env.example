# Copie para .env e preencha com a URL do Neon (NUNCA commitar o .env):
#   copy .env.example .env
#
# No painel Neon: Connect → Postgres → copie a connection string (Show password).
# Preferir conexão DIRETA (sem "-pooler") no MVP.
# Se a conexão Python falhar com channel_binding, use só ?sslmode=require

# --- Neon (padrão do projeto — substitui Docker) ---
DATABASE_URL=postgresql://neondb_owner:SUA_SENHA@ep-XXXX.sa-east-1.aws.neon.tech/neondb?sslmode=require

# --- LLM (T-006) — padrão: none + template (custo zero) ---
# Para extracao de formulario com IA local: LLM_PROVIDER=ollama
LLM_PROVIDER=none
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_TIMEOUT_SECONDS=90
# FORM_EXTRACT_USE_LLM=true


# --- Paths ---
DATA_DIR=data
RAW_PDFS_DIR=data/raw_pdfs
TEXTS_DIR=data/texts
OUTPUTS_DIR=data/outputs

# --- Embeddings (T-020+) ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# auto = tenta MiniLM; se HuggingFace bloquear, usa hashing offline
EMBEDDING_BACKEND=auto

# --- Auth (login / sessao) ---
AUTH_SECRET=troque-este-segredo-em-producao
AUTH_TOKEN_TTL_HOURS=72
AUTH_RESET_TTL_MINUTES=60
APP_PUBLIC_URL=http://127.0.0.1:8000

# --- Criptografia at-rest de dossiês (PDF, raw_text, form_data) ---
# Sem esta chave, arquivos/textos ficam em claro (compatível com legado).
# Com a chave: cifra autenticada no servidor (HMAC-SHA256); decifrado só na memória.
# NÃO expor no frontend. Não é E2E — o servidor precisa do texto em claro para analisar.
# Gerar: python -c "from app.crypto import generate_encryption_key; print(generate_encryption_key())"
# PROJECT_DATA_ENCRYPTION_KEY=

# --- E-mail (opcional; sem SMTP o link de reset aparece na tela em dev) ---
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@exemplo.com
# SMTP_USE_TLS=true

# --- BNDES Developers@BNDES (tentativa TCC — NÃO usada no motor) ---
# ADR-009: autorização na Loja de APIs NÃO obtida. Variáveis abaixo ficam só
# como registro da tentativa; o SADS trata BNDES de forma ampla (sem linhas).
# Docs: docs/integrations/BNDES_API_PORTFOLIO.md
# BNDES_CLIENT_ID=
# BNDES_CLIENT_SECRET=
# BNDES_TOKEN_URL=
# BNDES_OAUTH_SCOPE=
# BNDES_PORTFOLIO_BASE_URL=https://gateway-h.apis.bndes.gov.br/produtos/v1
# BNDES_PORTFOLIO_OBTER_CONFIG_URL=
# BNDES_TIMEOUT_SECONDS=30
# BNDES_MAX_RETRIES=2
# BNDES_VERIFY_SSL=true

